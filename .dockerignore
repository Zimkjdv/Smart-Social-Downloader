# Deny by default, including local state, downloads, .git and .venv.
**
!Dockerfile
!.dockerignore
!requirements.lock.txt
!app.py
!LICENSE
!THIRD_PARTY_NOTICES.md
!ssdl/
!ssdl/*.py
!static/
!static/*.html
!static/*.css
!static/*.js
!chrome-extension/
!chrome-extension/manifest.json
!chrome-extension/*.html
!chrome-extension/*.js
!chrome-extension/README.md
!docker/
!docker/entrypoint.py
!docker/runtime.py
!docker/storage.py
!docker/healthcheck.py
!docker/session_key.py
!docker/debian.sources

# Final exclusions also apply under allowed source directories.
**/__pycache__/**
**/*.py[cod]
**/data/**
**/downloads/**
**/.env*
**/*cookie*.txt
**/*cookie*.json
**/*cookie*.sqlite*
**/*auth*.bin
**/*.pem
**/*.key
**/*.pfx
**/*.p12
