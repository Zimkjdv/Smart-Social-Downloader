{
  "manifest_version": 3,
  "name": "Smart Social Downloader · X / Pixiv 連接器",
  "description": "連接 Chrome 中的 X 登入狀態，並自動接回使用者啟動的 Pixiv 授權。資料只傳送到本機工具。",
  "version": "1.2.0",
  "minimum_chrome_version": "109",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1/*",
    "https://app-api.pixiv.net/*",
    "https://accounts.pixiv.net/*",
    "https://www.pixiv.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "連接已登入的 X",
    "default_popup": "popup.html"
  }
}
