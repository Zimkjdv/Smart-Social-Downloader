{
  "manifest_version": 3,
  "name": "Smart Social Downloader · X 連接器",
  "description": "將這個 Chrome 個人檔案已登入的 X 狀態連接到本機下載工具。只傳送 X 登入 Cookie 到 127.0.0.1。",
  "version": "1.1.0",
  "minimum_chrome_version": "109",
  "key": "",
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["connect.js"], "run_at": "document_idle" }],
  "action": { "default_title": "連接已登入的 X", "default_popup": "popup.html" }
}
